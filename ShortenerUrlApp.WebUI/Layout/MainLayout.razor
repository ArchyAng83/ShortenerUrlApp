@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudLink Href="/" Underline="Underline.None" Class="mx-2">
            <MudText Typo="Typo.h6">ShortenerUrl</MudText>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="d-none d-sm-flex mr-2">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit"
                               title="Sign out"
                               OnClick="LogoutAsync" />
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Login</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Class="ml-2" Href="/register">Register</MudButton>
            </NotAuthorized>
        </AuthorizeView>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                       OnClick="ToggleDarkMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Class="@(_isDarkMode ? string.Empty : "drawer-accent")">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">ShortenerUrl</MudText>
        </MudDrawerHeader>
        <AuthorizeView>
            <Authorized>
                <MudNavMenu>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>
                    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
                </MudNavMenu>
            </Authorized>
            <NotAuthorized>
                <MudNavMenu>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>
                    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
                    <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
                </MudNavMenu>
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            // Light mode: the sidebar shares the app bar color. Drawer text/icons turn
            // white for contrast; dark mode keeps the MudBlazor default palette untouched.
            AppbarBackground = "#594AE2",
            DrawerBackground = "#594AE2",
            DrawerText = "#FFFFFF",
            DrawerIcon = "#FFFFFF"
        }
    };

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private JwtAuthStateProvider AuthState { get; set; } = default!;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private async Task LogoutAsync()
    {
        await AuthState.SignOutAsync();

        // forceLoad guarantees the fresh app state wins over any in-flight re-render of
        // the protected page (which would otherwise bounce the user to /login).
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
