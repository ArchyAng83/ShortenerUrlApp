@page "/reset-password"
@inject AuthService AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Reset password — ShortenerUrl</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-10">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudCard Elevation="6">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Set a new password</MudText>
                    <MudText Typo="Typo.body2">For account <strong>@Email</strong>.</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" Size="Size.Medium" />
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent Class="pt-0">
                @if (_busy)
                {
                    <div class="text-center pa-6">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body1" Class="mt-3">Resetting your password…</MudText>
                    </div>
                }
                else if (_succeeded == true)
                {
                    <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.h5" Class="mt-3">Password updated</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">
                        You can sign in with your new password now.
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Href="/login"
                               Class="mt-5">
                        Sign in
                    </MudButton>
                }
                else if (_validLink)
                {
                    <EditForm Model="_input" OnValidSubmit="SubmitAsync">
                        <DataAnnotationsValidator />

                        <MudTextField @bind-Value="_input.NewPassword"
                                      For="@(() => _input.NewPassword)"
                                      Label="New password"
                                      InputType="_showPassword ? InputType.Text : InputType.Password"
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      IconSize="Size.Medium"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      HelperText="At least 10 characters."
                                      HelperTextOnFocus="true"
                                      Class="mb-4" />

                        <MudTextField @bind-Value="_input.ConfirmPassword"
                                      For="@(() => _input.ConfirmPassword)"
                                      Label="Confirm new password"
                                      InputType="_showPassword ? InputType.Text : InputType.Password"
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"
                                      Class="mb-4" />

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="_busy">
                            @if (_busy)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                                <span>Updating…</span>
                            }
                            else
                            {
                                <span>Update password</span>
                            }
                        </MudButton>
                    </EditForm>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Class="mt-4">
                            @_error
                        </MudAlert>
                    }
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                    <MudText Typo="Typo.h5" Class="mt-3">Invalid reset link</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">@_error</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/forgot-password"
                               Class="mt-5">
                        Request a new link
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "New password is required.")]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private ResetInput _input = new();
    private bool _showPassword;
    private bool _busy;
    private bool _validLink;
    private bool? _succeeded;
    private string? _error;

    protected override void OnParametersSet()
    {
        _validLink = !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);

        if (!_validLink)
        {
            _error = "The reset link is missing its email or token. Copy the full link from your email.";
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        if (_input.NewPassword != _input.ConfirmPassword)
        {
            Snackbar.Add("The passwords do not match.", Severity.Error);
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await AuthApi.ResetPasswordAsync(new ResetPasswordDto(Email!, Token!, _input.NewPassword));

            _succeeded = result.Succeeded;

            if (!result.Succeeded)
            {
                _error = result.Errors.FirstOrDefault() ?? "The reset token is invalid or has expired. Request a new link.";
            }
        }
        finally
        {
            _busy = false;
        }
    }
}