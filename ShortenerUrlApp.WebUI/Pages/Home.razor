@page "/"

<PageTitle>ShortenerUrl — short links, big insight</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudGrid Justify="Justify.Center" Class="mt-10">
            <MudItem xs="12" sm="8" md="6">
                <MudPaper Class="pa-10 text-center" Elevation="4">
                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4" Class="mt-4">Welcome back, @(context.User.Identity?.Name ?? "friend")</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Default" Class="mt-2 mb-6">
                        Manage your shortened links and check their analytics in one place.
                    </MudText>
                    <MudButton Href="/dashboard"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Open Dashboard
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </Authorized>

    <NotAuthorized>
        @* Hero section *@
        <div class="hero-gradient rounded-lg pa-8 pa-md-16">
            <MudGrid Justify="Justify.Center">
                <MudItem xs="12" md="8" Class="text-center">
                    <MudChip T="string" Icon="@Icons.Material.Filled.Bolt" Color="Color.Tertiary" Variant="Variant.Filled" Class="mb-4">
                        Free · Fast · Trackable
                    </MudChip>
                    <MudText Typo="Typo.h2" Class="font-weight-bold">Shorten. Share. Track.</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Inherit" Class="mt-4 mb-8" Style="max-width: 640px; margin-inline: auto;">
                        Turn long, ugly URLs into clean short links — with custom aliases,
                        expiry rules, click caps, QR codes and per-link analytics.
                    </MudText>
                    <MudButton Href="/register"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="mr-3"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Get started free
                    </MudButton>
                    <MudButton Href="/login"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Large">
                        I already have an account
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

        @* Feature grid *@
        <MudGrid Justify="Justify.Center" Class="mt-12">
            @foreach (var feature in Features)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="pa-2 text-center h-100" Elevation="2">
                        <MudCardContent>
                            <MudIcon Icon="@feature.Icon" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Class="mt-3 mb-2">@feature.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">@feature.Description</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </NotAuthorized>
</AuthorizeView>

<style>
    .hero-gradient {
        background: linear-gradient(135deg, rgba(89, 74, 226, 0.9) 0%, rgba(156, 39, 176, 0.85) 100%);
        color: #fff;
    }
</style>

@code {
    private sealed record Feature(string Icon, string Title, string Description);

    private static readonly Feature[] Features =
    [
        new(Icons.Material.Filled.Link, "Custom aliases",
            "Pick your own short code (3–20 characters) or let us generate one for you."),
        new(Icons.Material.Filled.Timer, "Expiration & limits",
            "Set a link lifetime in minutes and cap the maximum number of clicks."),
        new(Icons.Material.Filled.QrCode2, "QR codes",
            "Every link gets a QR code you can display and download for offline use."),
        new(Icons.Material.Filled.Analytics, "Click analytics",
            "See clicks over time, audience by country and top referrers per link."),
    ];
}
