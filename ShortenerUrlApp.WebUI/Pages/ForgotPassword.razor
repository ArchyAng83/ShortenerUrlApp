@page "/forgot-password"
@inject AuthService AuthApi
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Forgot password — ShortenerUrl</PageTitle>

@* Redirect authenticated users to dashboard *@
@if (_isAuthenticated)
{
    Navigation.NavigateTo("/dashboard");
    return;
}

<MudGrid Justify="Justify.Center" Class="mt-10">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudCard Elevation="6">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Reset your password</MudText>
                    <MudText Typo="Typo.body2">We&apos;ll email you a link to reset it.</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Medium" />
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent Class="pt-0">
                @if (_sent)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                        If an account exists for <strong>@_input.Email</strong>, a password reset link has been sent.
                    </MudAlert>

                    <MudText Typo="Typo.body2" Class="mb-6">
                        Check your inbox and follow the link to choose a new password.
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Href="/login">
                        Sign in
                    </MudButton>
                }
                else
                {
                    <EditForm Model="_input" OnValidSubmit="SubmitAsync">
                        <DataAnnotationsValidator />

                        <MudTextField @bind-Value="_input.Email"
                                      For="@(() => _input.Email)"
                                      Label="Email"
                                      InputType="InputType.Email"
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"
                                      Placeholder="you@example.com"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      IconSize="Size.Medium"
                                      Immediate="true" />

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Class="mt-6"
                                   Size="Size.Large"
                                   Disabled="_busy">
                            @if (_busy)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                                <span>Requesting…</span>
                            }
                            else
                            {
                                <span>Send reset link</span>
                            }
                        </MudButton>
                    </EditForm>
                }
            </MudCardContent>

            <div class="d-flex justify-space-between pa-4" style="border-top:1px solid rgba(128,128,128,0.12);">
                <MudText Typo="Typo.body2">Remembered your password?</MudText>
                <MudLink Href="/login" Typo="Typo.body2">Sign in</MudLink>
            </div>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private sealed class ForgotPasswordInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }

    private ForgotPasswordInput _input = new();
    private bool _busy;
    private bool _sent;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            var result = await AuthApi.ForgotPasswordAsync(new ForgotPasswordDto(_input.Email));

            // The endpoint always succeeds (anti-enumeration); a failure here means a transport issue.
            if (!result.Succeeded && result.Errors.Count > 0)
            {
                Snackbar.Add(string.Join("\n", result.Errors.Take(3)), Severity.Error);
                return;
            }

            _sent = true;
        }
        finally
        {
            _busy = false;
        }
    }
}