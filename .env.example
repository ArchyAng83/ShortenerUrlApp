# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=UrlShortenerDb

# Redis
REDIS_URL=redis:6379

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_ISSUER=ShortenerUrlApp
JWT_AUDIENCE=ShortenerUrlApp
JWT_EXPIRY_MINUTES=60

# API
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5153

# GeoIP (optional): free MaxMind license key for the GeoLite2 download (https://www.maxmind.com).
# Empty = the API image falls back to the P3TERX mirror (community GeoLite2 city db).
MAXMIND_LICENSE_KEY=
GEOIP_DATABASE_PATH=Data/GeoLite2-City.mmdb

# UI
UI_PORT=5209
